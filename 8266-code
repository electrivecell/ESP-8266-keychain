#include <ESP8266WiFi.h>
#include <ESPAsyncTCP.h>
#include <ESPAsyncWebServer.h>
#include <LittleFS.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// --- OLED Hardware Settings ---
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// --- Access Point Credentials ---
const char* AP_SSID = "ESP8266-OLED-Frame";
const char* AP_PASS = "12345678"; // Must be at least 8 characters

// --- Globals ---
AsyncWebServer server(80);
unsigned long intervalMs = 3000;
unsigned long lastSwitchTime = 0;
int currentImageIndex = 0;

// Embedded HTML UI with inline CSS & JavaScript (Converts images client-side)
const char INDEX_HTML[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ESP OLED Frame</title>
  <style>
    body { font-family: sans-serif; background: #121212; color: #fff; margin: 0; padding: 20px; text-align: center; }
    .card { background: #1e1e1e; padding: 20px; border-radius: 12px; max-width: 400px; margin: 0 auto 20px auto; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    h2 { margin-top: 0; color: #00adb5; }
    input[type=file], input[type=number] { width: 100%; padding: 10px; margin: 10px 0; border-radius: 6px; border: 1px solid #333; background: #2b2b2b; color: #fff; box-sizing: border-box; }
    button { width: 100%; padding: 12px; border-radius: 6px; border: none; font-weight: bold; cursor: pointer; background: #00adb5; color: #fff; margin-top: 8px; }
    button.clear { background: #ff2e63; }
    #canvas { display: none; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Upload Images</h2>
    <input type="file" id="fileInput" accept="image/*" multiple>
    <button onclick="processAndUpload()">Upload Selected</button>
  </div>

  <div class="card">
    <h2>Display Settings</h2>
    <label>Interval (seconds):</label>
    <input type="number" id="interval" value="3" min="0.5" step="0.5">
    <button onclick="updateInterval()">Save Timing</button>
    <button class="clear" onclick="clearImages()">Delete All Images</button>
  </div>

  <canvas id="canvas" width="128" height="64"></canvas>

  <script>
    async function processAndUpload() {
      const files = document.getElementById('fileInput').files;
      if (!files.length) return alert("Please select at least one picture!");

      const canvas = document.getElementById('canvas');
      const ctx = canvas.getContext('2d');

      for (let f = 0; f < files.length; f++) {
        const img = await loadImage(files[f]);
        
        // Draw image scaled to 128x64 canvas
        ctx.fillStyle = "black";
        ctx.fillRect(0, 0, 128, 64);
        ctx.drawImage(img, 0, 0, 128, 64);

        // Extract pixel data and turn into 1-bit monochrome array
        const imgData = ctx.getImageData(0, 0, 128, 64).data;
        const buffer = new Uint8Array(1024);

        for (let i = 0; i < 1024; i++) {
          let byte = 0;
          for (let bit = 0; bit < 8; bit++) {
            const pixelIndex = (i * 8 + bit) * 4;
            // Grayscale calculation
            const avg = (imgData[pixelIndex] + imgData[pixelIndex + 1] + imgData[pixelIndex + 2]) / 3;
            if (avg > 128) {
              byte |= (1 << (7 - bit));
            }
          }
          buffer[i] = byte;
        }

        // Send converted binary payload to ESP8266
        const blob = new Blob([buffer], { type: 'application/octet-stream' });
        const formData = new FormData();
        formData.append('data', blob, `frame_${Date.now()}.bin`);

        await fetch('/upload', { method: 'POST', body: formData });
      }

      alert("Upload complete!");
    }

    function loadImage(file) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = URL.createObjectURL(file);
      });
    }

    function updateInterval() {
      const sec = parseFloat(document.getElementById('interval').value);
      fetch(`/set-interval?ms=${Math.round(sec * 1000)}`);
      alert("Interval updated!");
    }

    function clearImages() {
      if (confirm("Delete all images on screen?")) {
        fetch('/clear', { method: 'POST' });
        alert("Cleared!");
      }
    }
  </script>
</body>
</html>
)rawliteral";

// Render bitmap file onto SSD1306
void renderBitmap(const String& path) {
  if (!LittleFS.exists(path)) return;
  
  File file = LittleFS.open(path, "r");
  if (!file) return;

  uint8_t buffer[1024];
  size_t bytesRead = file.read(buffer, sizeof(buffer));
  file.close();

  if (bytesRead == sizeof(buffer)) {
    display.clearDisplay();
    display.drawBitmap(0, 0, buffer, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
    display.display();
  }
}

// Retrieve ordered list of image filenames from LittleFS
std::vector<String> getImageList() {
  std::vector<String> images;
  Dir dir = LittleFS.openDir("/");
  while (dir.next()) {
    if (dir.fileName().startsWith("img_")) {
      images.push_back("/" + dir.fileName());
    }
  }
  std::sort(images.begin(), images.end());
  return images;
}

void setup() {
  Serial.begin(115200);

  // Initialize OLED (Wire pins: SDA = GPIO4/D2, SCL = GPIO5/D1 on NodeMCU)
  Wire.begin(4, 5);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 10);
  display.println(F("Initializing FS..."));
  display.display();

  // Initialize File System
  if (!LittleFS.begin()) {
    LittleFS.format();
    LittleFS.begin();
  }

  // Start Access Point
  WiFi.softAP(AP_SSID, AP_PASS);
  IPAddress IP = WiFi.softAPIP();

  display.clearDisplay();
  display.setCursor(0, 0);
  display.println(F("AP Ready!"));
  display.print(F("SSID: ")); display.println(AP_SSID);
  display.print(F("IP: ")); display.println(IP);
  display.display();

  // --- Web Server Endpoints ---

  // Serve Embedded HTML Web App
  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request) {
    request->send_P(200, "text/html", INDEX_HTML);
  });

  // Handle Image Upload Endpoint
  server.on("/upload", HTTP_POST, [](AsyncWebServerRequest *request) {
    request->send(200, "text/plain", "OK");
  }, [](AsyncWebServerRequest *request, String filename, size_t index, uint8_t *data, size_t len, bool final) {
    static File uploadFile;
    if (!index) {
      String path = "/img_" + String(millis()) + ".bin";
      uploadFile = LittleFS.open(path, "w");
    }
    if (uploadFile) {
      uploadFile.write(data, len);
    }
    if (final) {
      if (uploadFile) uploadFile.close();
    }
  });

  // Handle Delay Setting
  server.on("/set-interval", HTTP_GET, [](AsyncWebServerRequest *request) {
    if (request->hasParam("ms")) {
      intervalMs = request->getParam("ms")->value().toInt();
      request->send(200, "text/plain", "OK");
    } else {
      request->send(400, "text/plain", "Missing parameter");
    }
  });

  // Handle Deleting Images
  server.on("/clear", HTTP_POST, [](AsyncWebServerRequest *request) {
    Dir dir = LittleFS.openDir("/");
    while (dir.next()) {
      if (dir.fileName().startsWith("img_")) {
        LittleFS.remove("/" + dir.fileName());
      }
    }
    display.clearDisplay();
    display.setCursor(0, 20);
    display.println(F("No Images Stored"));
    display.display();
    request->send(200, "text/plain", "Cleared");
  });

  server.begin();
}

void loop() {
  unsigned long currentMillis = millis();
  
  if (currentMillis - lastSwitchTime >= intervalMs) {
    lastSwitchTime = currentMillis;

    std::vector<String> images = getImageList();
    if (!images.empty()) {
      if (currentImageIndex >= images.size()) {
        currentImageIndex = 0;
      }
      renderBitmap(images[currentImageIndex]);
      currentImageIndex++;
    }
  }
}
